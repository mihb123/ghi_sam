# ============ TELEGRAM ============
# Lay tu @BotFather: /newbot -> copy token. De trong = tat Telegram.
# LUU Y: de bot doc duoc tin nhan tran trong group, tat Group Privacy:
#   @BotFather -> /mybots -> chon bot -> Bot Settings -> Group Privacy -> Turn off
TELEGRAM_BOT_TOKEN=

# Allowlist chat Telegram, cach nhau bang dau phay. De trong = cho phep moi chat.
TELEGRAM_CHAT_ID=

# ============ ZALO ============
# Lay tu https://zalo.me/s/botcreator/. De trong = tat Zalo.
ZALO_BOT_TOKEN=

# Zalo gui khoa nay trong header X-Bot-Api-Secret-Token de xac thuc webhook.
# Thieu no thi bat ky ai cung goi duoc webhook. Tao moi: openssl rand -hex 24
ZALO_SECRET_TOKEN=

# URL cong khai HTTPS tro toi webhook. Bot tu goi setWebhook luc khoi dong.
# Zalo KHONG chap nhan http, localhost hay IP noi bo.
ZALO_WEBHOOK_URL=https://sam.mihb.site/zalo/webhook

# Allowlist chat Zalo, cach nhau bang dau phay. De trong = cho phep moi chat.
ZALO_CHAT_ID=

# ============ HTTP SERVER (can khi bat Zalo hoac trang web) ============
# App chay HTTP thuan, khong TLS. Cloudflare Tunnel (hoac reverse proxy khac) lo HTTPS.
# Cong nay phai khop voi ingress trong /etc/cloudflared/config.yml
WEB_HOST=0.0.0.0
WEB_PORT=10240

# ============ TRANG WEB (PWA xem tren dien thoai) ============
# 0 = tat han trang web va API. Bat thi server HTTP luon duoc mo.
WEB_UI=1

# Goc URL cong khai cua trang web, dung de lenh /web dung link gui vao nhom.
# Thuong trung domain da tro toi app qua Cloudflare Tunnel.
WEB_PUBLIC_URL=https://sam.mihb.site

# Thu muc ban build cua React (chay `cd web && npm install && npm run build`).
# Trong Docker gia tri nay bi ghi de thanh /app/web/dist.
WEB_DIST=./web/dist

# ============ GOOGLE SHEETS ============
# File JSON key cua Service Account. Nho bat Google Sheets API + Google Drive API,
# roi Share sheet cho email service account voi quyen Editor.
GOOGLE_SA_JSON=./secrets/service_account.json

# Sheet dung khi chat chua tu set bang lenh sheet
DEFAULT_SHEET_URL=https://docs.google.com/spreadsheets/d/1KsAUkCFLH4OmQWvEjjLazITxtsb0-gK3Fd2LE9pi6Uw/edit?usp=sharing

# Ten tab se bi ghi de moi lan export
SHEET_TAB_NAME=Chi tiet van

# ============ THONG KE & GIOI THIEU ============
# Ai duoc go lenh /thongke trong chat. Dang "<platform>:<user_id>", cach nhau bang dau phay.
# De trong = khong ai la admin; luc do go /thongke se duoc bot in ra user_id de dien vao day.
ADMIN_USER_IDS=

# Token mo trang thong ke /admin?k=... va API /api/stats?k=...
# De trong = tat han ca hai (tra 404). Tao moi: openssl rand -hex 24
ADMIN_STATS_TOKEN=

# Username cua bot Telegram, dung dung link moi t.me/<username>?start=r_<MA>.
# Thuong khong can dien: bot tu lay bang getMe luc khoi dong. Chi dat khi muon ghi de.
TELEGRAM_BOT_USERNAME=

# Link mo bot Zalo, lay trong Zalo Bot Creator. Zalo khong ho tro tham so trong link nen
# link moi cua nguoi dung Zalo se di qua trang /i/<MA> cua minh roi chuyen tiep tai day.
ZALO_BOT_LINK=

# Cua so ghep click trang /i/<MA> voi nguoi dung Zalo moi (phut). Trong cua so nay neu co
# dung 1 ma duoc bam thi gan nguon (danh dau la suy doan); nhieu hon 1 thi bo qua.
REF_CLICK_WINDOW_MIN=30

# Giu log luu luong bao nhieu ngay; cu hon se bi xoa luc khoi dong.
USAGE_RETENTION_DAYS=180

# ============ DATABASE ============
# File SQLite; tu dong tao va tu migrate neu chua co
DB_PATH=./data/ghibai.db

# ============ DOCKER ============
# Phai khop UID/GID cua host de container ghi duoc vao ./data. Lay: id -u  va  id -g
DOCKER_UID=1000
DOCKER_GID=1000
